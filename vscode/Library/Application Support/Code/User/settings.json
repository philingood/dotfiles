{
    "chat.byokUtilityModelDefault": "mainAgent",
    "chat.disableAIFeatures": true,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.utilityModel": "",
    "chat.utilitySmallModel": "",
    "codeTelescope.layout.previewFontSize": 12,
    "codeTelescope.layout.promptFontSize": 12,
    "codeTelescope.layout.resultsFontSize": 12,
    "editor.accessibilitySupport": "off",
    "editor.guides.highlightActiveIndentation": false,
    "editor.guides.indentation": false,
    "files.autoSave": "afterDelay",
    "git.autofetch": true,
    "terminal.integrated.macOptionIsMeta": true,
    "window.commandCenter": false,
    "workbench.activityBar.location": "top",
    "workbench.browser.showInTitleBar": false,
    "workbench.editor.showTabs": "none",
    "workbench.experimental.modernUI": true,
    "workbench.layoutControl.enabled": false,
    "workbench.navigationControl.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.sideBar.defaultVisibility": "hidden",
    "workbench.startupEditor": "none",
    "explorer.confirmDragAndDrop": false,
    "editor.fontFamily": "MesloLGLDZ Nerd Font , Menlo, Monaco, 'Courier New', monospace",
    "workbench.colorTheme": "Kanagawa Dragon Kazte",
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.horizontal": "hidden",
    "redhat.telemetry.enabled": false,
    "security.promptForLocalFileProtocolHandling": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "editor.minimap.showSlider": "always",
    "editor.minimap.enabled": false,
    "vim.easymotion": true,
    "vim.foldfix": true,
    "vim.highlightedyank.enable": true,
    "vim.hlsearch": true,
    "vim.sneak": true,
    "vim.sneakReplacesF": true,
    "vim.useSystemClipboard": true,
    "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
    "workbench.editor.editorActionsLocation": "hidden",
    "python.analysis.typeCheckingMode": "strict",
    "workbench.editorAssociations": {
        "*.md": "default"
    },
    "go.toolsManagement.autoUpdate": true,
    "notebook.lineNumbers": "on",
    "files.autoGuessEncoding": true,
    "editor.unicodeHighlight.includeStrings": false,
    "editor.fontSize": 13,
}